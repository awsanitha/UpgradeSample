@using Microsoft.AspNetCore.Identity
@inject SignInManager<eShopLegacyMVC.Models.ApplicationUser> SignInManager
@inject UserManager<eShopLegacyMVC.Models.ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-action="LogOff" asp-controller="Account" method="post" id="logoutForm" class="navbar-right">
        @Html.AntiForgeryToken()
        <ul class="nav navbar-nav navbar-right">
            <li>
                Hello, @UserManager.GetUserName(User)!
            </li>
            <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>
        </ul>
    </form>
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a asp-action="Register" asp-controller="Account" id="registerLink">Register</a></li>
        <li><a asp-action="Login" asp-controller="Account" id="loginLink">Log in</a></li>
    </ul>
}
